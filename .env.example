# Clé API Riot (developer.riotgames.com) — expire toutes les 24h pour une clé dev
RIOT_API_KEY=
# Ton Riot ID : gameName#tagLine
RIOT_GAME_NAME=
RIOT_TAG_LINE=
# Plateforme (euw1, eun1, na1...)
RIOT_PLATFORM=euw1
# Clé API Anthropic pour l'auditor (console.anthropic.com) — via `skibot set-anthropic-key`
ANTHROPIC_API_KEY=
