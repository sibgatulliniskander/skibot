# Clé API Riot (developer.riotgames.com) — expire toutes les 24h pour une clé dev
RIOT_API_KEY=
# Ton Riot ID : gameName#tagLine
RIOT_GAME_NAME=
RIOT_TAG_LINE=
# Plateforme (euw1, eun1, na1...)
RIOT_PLATFORM=euw1
# Comptes secondaires (smurfs) suivis dans la même base, séparés par ;
# ex : MonSmurf#EUW;AutreCompte#123 — la courbe LP publique reste le compte principal
RIOT_ALT_ACCOUNTS=
# Clé API Anthropic pour l'auditor (console.anthropic.com) — via `skibot set-anthropic-key`
ANTHROPIC_API_KEY=
# Comptes éligibles aux ANALYSES de décision (règle n°11) — un smurf n'y entre
# que quand son rang rejoint l'ère courante. Vide = tous.
RIOT_ANALYSIS_ACCOUNTS=
